# =============================================================================
# AI Output Evaluation — environment template
# Copy to backend/.env (recommended) or project root .env
# =============================================================================

# --- Groq (primary LLM — OpenAI-compatible API) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider: groq | openai | anthropic
LLM_PROVIDER=groq

# Groq model IDs (see https://console.groq.com/docs/models)
LLM_MODEL_ANALYSIS=llama-3.1-8b-instant
LLM_MODEL_EVAL=llama-3.3-70b-versatile
LLM_MODEL_REGEN=llama-3.3-70b-versatile

# Legacy alias (optional — GROQ_API_KEY is preferred when LLM_PROVIDER=groq)
LLM_API_KEY=

# --- Pipeline mode ---
# true  = mock JSON (no API calls; works without GROQ_API_KEY)
# false = live LLM pipeline (requires GROQ_API_KEY; Phases 3–5)
# NOTE: Set to false for production deployment
MOCK_MODE=true

# --- Optional search (claim verification / attribution) ---
SEARCH_API_KEY=
ENABLE_WEB_SEARCH=false

# --- Limits ---
MAX_RESPONSE_CHARS=32000
MAX_CLAIMS=40

# --- Server ---
# Local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployment ---
# Backend (Streamlit): Set MOCK_MODE=false and configure GROQ_API_KEY
# Frontend (Vercel): Set VITE_API_BASE to your deployed backend URL
# VITE_API_BASE=https://your-streamlit-app.streamlit.app

# --- Frontend (optional) ---
# Leave VITE_API_BASE empty to use Vite proxy (default target port 8001)
# VITE_API_BASE=http://127.0.0.1:8001
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001
