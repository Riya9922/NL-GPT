# Streamlit Secrets Template
# Copy this to .streamlit/secrets.toml in your Streamlit Cloud app

# Pipeline mode (MUST be false for production)
MOCK_MODE = "false"

# Groq API Configuration
GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_BASE_URL = "https://api.groq.com/openai/v1"

# LLM Provider and Models
LLM_PROVIDER = "groq"
LLM_MODEL_ANALYSIS = "llama-3.1-8b-instant"
LLM_MODEL_EVAL = "llama-3.3-70b-versatile"
LLM_MODEL_REGEN = "llama-3.3-70b-versatile"

# CORS Origins (set to your Vercel frontend URL)
CORS_ORIGINS = "https://your-app.vercel.app,https://your-app-git-main.vercel.app"

# Optional: Web search for claim verification
# SEARCH_API_KEY = "your_search_api_key"
# ENABLE_WEB_SEARCH = "false"

# Limits
MAX_RESPONSE_CHARS = "32000"
MAX_CLAIMS = "40"
