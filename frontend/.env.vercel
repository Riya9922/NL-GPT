# Vercel Environment Variables
# Copy this to .env for local development or add to Vercel dashboard

# API Base URL for deployed backend (Railway/Render)
# For production: VITE_API_BASE=https://your-backend.up.railway.app
# For local development: VITE_API_BASE=http://127.0.0.1:8001

# Example (replace with your actual backend URL):
VITE_API_BASE=https://nl-gpt-production.up.railway.app
